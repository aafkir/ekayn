---
import BaseLayout from '../layouts/BaseLayout.astro';
import StorePanels from '../components/StorePanels.astro';
export const prerender = true;
---
<BaseLayout title="Commande confirmée — Ekayn" description="Confirmation de votre commande Ekayn.">
  <main class="payment-result"><p class="eyebrow">PAIEMENT</p><h1>Merci pour votre commande.</h1><p id="payment-status">Vérification du paiement en cours…</p><a class="primary" href="/">Retour à la collection <span>↗</span></a></main><StorePanels /><script src="../scripts/store.ts"></script>
  <script>
    const status = document.querySelector<HTMLElement>('#payment-status')!; const sessionId = new URLSearchParams(location.search).get('session_id');
    if (!sessionId) status.textContent = 'La session de paiement est introuvable. Contactez-nous si vous avez été débité.';
    else fetch(`/api/order-status?session_id=${encodeURIComponent(sessionId)}`).then(async (response) => { const data = await response.json() as { paymentStatus?: string; items?: { id: string; quantity: number }[]; error?: string }; if (!response.ok) throw new Error(data.error); if (data.paymentStatus === 'paid') { status.textContent = 'Votre paiement est confirmé. Votre commande va être préparée.'; const cart = JSON.parse(localStorage.getItem('ekayn-cart') || localStorage.getItem('tifilit-cart') || '{}'); (data.items || []).forEach((item: { id: string; quantity: number }) => { cart[item.id] = Math.max(0, (cart[item.id] || 0) - item.quantity); if (!cart[item.id]) delete cart[item.id]; }); localStorage.setItem('ekayn-cart', JSON.stringify(cart)); localStorage.removeItem('tifilit-cart'); } else status.textContent = 'Le paiement n’est pas encore confirmé. Nous mettrons votre commande à jour dès réception de la confirmation.'; }).catch(() => { status.textContent = 'Nous ne pouvons pas confirmer le paiement pour le moment. Contactez-nous si vous avez été débité.'; });
  </script>
  <style is:global>.payment-result { max-width: 850px; min-height: 55vh; margin: 0 auto; padding: 110px 6%; }.payment-result h1 { font-size: clamp(45px, 6vw, 76px); }.payment-result p:not(.eyebrow) { color: var(--muted); margin: 25px 0 32px; }</style>
</BaseLayout>
