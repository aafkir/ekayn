---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout title="Page introuvable — Ekayn" description="Cette page Ekayn n’existe pas ou n’est plus disponible.">
  <main class="not-found">
    <p class="eyebrow">ERREUR 404</p>
    <h1>Cette page n’existe pas.</h1>
    <p>Le produit recherché est introuvable. Retrouvez toute la collection Ekayn.</p>
    <a class="primary" href="/">Retour à l’accueil <span>↗</span></a>
  </main>
  <style is:global>
    .not-found { max-width: 900px; min-height: 55vh; margin: 0 auto; padding: 110px 6%; }
    .not-found h1 { font-size: clamp(48px, 7vw, 82px); margin-bottom: 20px; }
    .not-found p:not(.eyebrow) { color: var(--muted); margin-bottom: 30px; }
  </style>
</BaseLayout>
