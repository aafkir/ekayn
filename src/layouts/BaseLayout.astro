---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Ekayn — Bijoux d’inspiration traditionnelle', description = 'Découvrez Ekayn, une sélection de bijoux élégants d’inspiration traditionnelle.', canonicalPath = '/' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://tifilit.com';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
---
<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#152d3c" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/assets/icon.png" />
    <title>{title}</title>
    <script is:inline>
      // Safari peut masquer l'iPhone dans son user-agent quand "Version pour ordinateur" est actif.
      const isAppleTouchDevice = /iPhone|iPad|iPod/.test(navigator.userAgent)
        || (navigator.userAgent.includes('Macintosh') && navigator.maxTouchPoints > 1);
      if (isAppleTouchDevice || window.screen.width <= 768) {
        document.documentElement.classList.add('mobile-device');
      }
    </script>
    <style is:global>
      .brand-image { display: inline-flex; flex-direction: column; align-items: flex-start; }
      .brand-image img { display: block; width: 190px; height: auto; max-height: 72px; object-fit: contain; }
      .brand-image .brand-tagline { display: block; margin-top: 5px; font-family: Arial, sans-serif; color: var(--muted); font-size: 9px; font-weight: 400; letter-spacing: 2.5px; line-height: 1.3; }
      footer .brand-image img { width: 170px; max-height: 58px; }
      .menu-panel .brand-image img { width: min(300px, 100%); filter: brightness(0) invert(1); }
      @media (max-width: 650px) { .brand-image img { width: 145px; max-height: 58px; } footer .brand-image img { width: 145px; } .brand-image .brand-tagline { font-size: 8px; letter-spacing: .8px; } }
      /* Safari peut afficher un iPhone en "version pour ordinateur" avec une largeur CSS de bureau. */
      @media (pointer: coarse) and (max-width: 1024px) {
        header > nav { display: none; }
        .hero { grid-template-columns: 1fr; padding: 10px 5% 40px; gap: 30px; }
        .hero-copy { padding-top: 26px; }
        .hero-photo { min-height: 450px; }
        .products { grid-template-columns: 1fr; }
        .product-image { height: auto; aspect-ratio: 4 / 5; }
        .heritage { grid-template-columns: 1fr; gap: 25px; padding: 45px 6%; }
        .heritage-label { display: flex; gap: 20px; align-items: center; }
        .heritage-label > span { font-size: 58px; }
        .heritage-label p { margin: 0; }
        .steps { flex-direction: column; gap: 8px; margin-top: 30px; }
      }
      /* Fallback pour le mode "site desktop" de Safari sur iPhone. */
      html.mobile-device header > nav { display: none !important; }
      html.mobile-device .hero { grid-template-columns: 1fr; padding: 10px 5% 40px; gap: 30px; }
      html.mobile-device .hero-copy { padding-top: 26px; }
      html.mobile-device .hero-photo { min-height: 450px; }
      html.mobile-device .products { grid-template-columns: 1fr; }
      html.mobile-device .product-image { height: auto; aspect-ratio: 4 / 5; }
      html.mobile-device .heritage { grid-template-columns: 1fr; gap: 25px; padding: 45px 6%; }
      html.mobile-device .heritage-label { display: flex; gap: 20px; align-items: center; }
      html.mobile-device .heritage-label > span { font-size: 58px; }
      html.mobile-device .heritage-label p { margin: 0; }
      html.mobile-device .steps { flex-direction: column; gap: 8px; margin-top: 30px; }
    </style>
  </head>
  <body>
    <div class="announcement">BIJOUX TRADITIONNELS AMAZIGHS · UN HÉRITAGE À PORTER</div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
