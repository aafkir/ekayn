---
import Layout from '../../../layouts/Layout.astro'; import { posts } from '../../../data/site';
---
<Layout title="Blog sobre tadelakt y bioconstrucción | Tadelakt Natural" description="Guías útiles sobre tadelakt, baños, mantenimiento, materiales naturales y decisiones de proyecto." path="/es/blog/"><div class="breadcrumbs">Inicio / Blog</div><section class="section container"><p class="eyebrow">Ideas y materia</p><h1>Un espacio para entender antes de elegir.</h1><div class="cards">{posts.map((post)=><article class="card"><a href={`/es/blog/${post.slug}/`}><img src={post.image} alt={post.title} width="1000" height="1000" loading="lazy"/><div class="card-body"><h2>{post.title}</h2><p>{post.description}</p><span>Leer artículo →</span></div></a></article>)}</div></section></Layout>
