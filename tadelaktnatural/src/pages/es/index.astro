---
import Layout from '../../layouts/Layout.astro';
import { services, posts } from '../../data/site';
const title = 'Tadelakt natural en España | Revestimientos artesanales de cal';
const description = 'Tadelakt Natural realiza revestimientos artesanales de cal para baños, duchas, hammams, piscinas, cocinas y proyectos de interiorismo natural.';
---
<Layout {title} {description} path="/es/" image="/assets/1d40bda2c59faa8c.jpg">
  <section class="hero"><img src="/assets/1d40bda2c59faa8c.jpg" alt="Baño y revestimiento artesanal de tadelakt natural" width="1500" height="1125" fetchpriority="high" /><div class="hero-content"><p class="eyebrow">Revestimientos naturales · Artesanía · Bioconstrucción</p><h1>La cal de Marrakech, aplicada con intención.</h1><p class="lead">Superficies continuas, tacto mineral y proyectos hechos a mano para espacios que quieren durar.</p><a class="button" href="/es/contacto/">Solicitar presupuesto</a><a class="button button-quiet" href="/es/proyectos/">Ver proyectos</a></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">Servicios</p><h2>Materia, proporción y oficio en cada superficie.</h2><p>Trabajamos con tadelakt y otros materiales naturales para crear acabados singulares en interiores y exteriores.</p></div><div class="cards">{services.slice(0,3).map((service) => <article class="card"><a href={`/es/servicios/${service.slug}/`}><img src={service.image} alt={`${service.title} revestido con tadelakt`} loading="lazy" width="800" height="600" /><div class="card-body"><h3>{service.title}</h3><p>{service.text}</p><span>Descubrir servicio →</span></div></a></article>)}</div></div></section>
  <section class="section band"><div class="container split"><div><p class="eyebrow">Por qué elegirlo</p><h2>Una belleza que también se toca.</h2><p>El tadelakt es un acabado de cal pulido, sin juntas visibles, con una presencia serena y una textura única. Su comportamiento depende de una correcta preparación, aplicación y conservación.</p><a class="button" href="/es/que-es-el-tadelakt/">Conocer el material</a></div><img src="/assets/0320965d69a0be48.jpg" alt="Textura de cal natural tadelakt" width="1044" height="1045" loading="lazy" /></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">Cómo trabajamos</p><h2>Del primer intercambio al último pulido.</h2></div><div class="process"><article><h3>Escuchar</h3><p>Entendemos el espacio, el uso y las expectativas del proyecto.</p></article><article><h3>Preparar</h3><p>Un buen soporte es la base de un acabado natural y duradero.</p></article><article><h3>Aplicar</h3><p>Trabajamos por capas, con precisión y atención a la materia.</p></article><article><h3>Acompañar</h3><p>Entregamos indicaciones claras para el cuidado de la superficie.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">Inspiración</p><h2>Algunos proyectos y lecturas.</h2></div><div class="gallery">{posts.map((post) => <a href={`/es/blog/${post.slug}/`}><img src={post.image} alt={post.title} loading="lazy" width="1000" height="1000" /></a>)}</div></div></section>
  <section class="section cta"><div class="container narrow"><p class="eyebrow">Hablemos de tu proyecto</p><h2>¿Tienes un espacio en mente?</h2><p>Cuéntanos qué quieres transformar y te responderemos por email con los próximos pasos.</p><a class="button" href="/es/contacto/">Contactar</a></div></section>
</Layout>
