---
import { site } from '../data/site';
import { locales, ui, languagePaths, type Locale } from '../i18n/config';
import '../styles/global.css';
interface Props { title: string; description: string; path: string; image?: string; noindex?: boolean; schema?: Record<string, unknown>; locale?: Locale; equivalents?: Partial<Record<Locale, string>>; }
const { title, description, path, image = '/assets/1d40bda2c59faa8c.jpg', noindex = false, schema, locale = 'es', equivalents = {} } = Astro.props as Props;
const text = ui[locale];
const langPaths = languagePaths[locale];
const nav = [{ href: langPaths.material, label: text.material }, { href: langPaths.services, label: text.services }, { href: langPaths.projects, label: text.projects }, { href: langPaths.blog, label: text.blog }, { href: langPaths.about, label: text.about }];
const alternatePaths = { es: equivalents.es || (locale === 'es' ? path : '/es/'), fr: equivalents.fr || (locale === 'fr' ? path : '/fr/'), en: equivalents.en || (locale === 'en' ? path : '/en/') };
const canonical = `${site.url}${path}`;
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, email: `mailto:${site.email}`, sameAs: [site.instagram] };
const graph = schema ? { '@context': 'https://schema.org', '@graph': [organization, schema] } : organization;
---
<!doctype html>
<html lang={locales[locale].lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}${image}`} />
    <link rel="icon" href="/assets/logo/logo.png" />
    {Object.entries(alternatePaths).map(([code, href]) => <link rel="alternate" hreflang={code} href={`${site.url}${href}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site.url}${alternatePaths.es}`} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{text.skip}</a>
    <header class="site-header">
      <a class="logo" href={langPaths.home} aria-label={`${site.name}, ${locales[locale].label}`}><img src="/assets/logo/logo.png" alt={site.name} width="220" height="127" /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">{text.menu}</button>
      <nav id="main-nav" aria-label="Navegación principal">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <div class="language-switcher" aria-label="Language selector">{Object.entries(locales).map(([code, item]) => <a class:list-active={code === locale} href={alternatePaths[code as Locale]} lang={item.lang} aria-current={code === locale ? 'page' : undefined}>{code.toUpperCase()}</a>)}</div>
        <a class="button button-small" href={langPaths.contact}>{text.quote}</a>
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <div><p class="eyebrow">TADELAKT NATURAL</p><p>Revestimientos artesanales de cal y materiales naturales.</p></div>
      <div><p class="eyebrow">Contacto</p><a href={`mailto:${site.email}`}>{site.email}</a><span>{site.city}</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></div>
      <div><p class="eyebrow">{text.explore}</p><a href={langPaths.services}>{text.services}</a><a href={langPaths.projects}>{text.projects}</a><a href={langPaths.contact}>{text.contact}</a><a href={langPaths.legal}>{text.legal}</a><a href={langPaths.privacy}>{text.privacy}</a><a href={langPaths.cookies}>{text.cookies}</a></div>
      <small>© {new Date().getFullYear()} Tadelakt Natural</small>
    </footer>
    <script>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');
      button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
    </script>
  </body>
</html>
