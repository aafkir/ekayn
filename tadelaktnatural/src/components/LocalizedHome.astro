---
import Layout from '../layouts/Layout.astro'; import { languagePaths, localizedServices } from '../i18n/config';
interface Props { locale: 'fr'|'en'; }
const { locale } = Astro.props as Props; const fr=locale==='fr'; const path=languagePaths[locale]; const copy=fr ? {eyebrow:'Enduits naturels · Artisanat · Bioconstruction',h1:'La chaux de Marrakech, appliquée avec intention.',lead:'Des surfaces continues, tactiles et minérales pour des espaces pensés pour durer.',services:'La matière, les proportions et le geste dans chaque surface.',why:'Une beauté qui se touche aussi.',process:'Du premier échange au dernier polissage.',cta:'Vous avez un espace en tête ?', quote:'Demander un devis', discover:'Découvrir le matériau'} : {eyebrow:'Natural finishes · Craft · Bioconstruction',h1:'Marrakech lime, applied with intention.',lead:'Continuous, tactile mineral surfaces for spaces made to last.',services:'Material, proportion and craft in every surface.',why:'Beauty you can feel.',process:'From the first conversation to the final polish.',cta:'Have a space in mind?',quote:'Request a quote',discover:'Discover the material'};
const cards = Object.entries(localizedServices[locale]).slice(0,3) as [string, readonly [string,string]][ ];
---
<Layout locale={locale} title={fr ? 'Tadelakt marocain artisanal en France et en Europe | Tadelakt Natural' : 'Traditional Moroccan tadelakt specialist | Tadelakt Natural'} description={fr ? 'Artisan spécialisé en tadelakt marocain et enduits naturels à la chaux pour salles de bains, douches, hammams et projets d’intérieur.' : 'Tadelakt specialist creating traditional Moroccan tadelakt and natural lime plaster finishes for bathrooms, showers, hammams and interiors.'} path={path.home} equivalents={{es:'/es/',fr:'/fr/',en:'/en/'}} image="/assets/1d40bda2c59faa8c.jpg">
  <section class="hero"><img src="/assets/1d40bda2c59faa8c.jpg" alt={fr ? 'Salle de bains avec revêtement artisanal en tadelakt' : 'Bathroom with handcrafted tadelakt finish'} width="1500" height="1125" fetchpriority="high" /><div class="hero-content"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.h1}</h1><p class="lead">{copy.lead}</p><a class="button" href={path.contact}>{copy.quote}</a><a class="button button-quiet" href={path.projects}>{fr ? 'Voir les réalisations' : 'View projects'}</a></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">{fr?'Services':'Services'}</p><h2>{copy.services}</h2><p>{fr?'Nous travaillons le tadelakt et les matériaux naturels pour créer des finitions singulières.':'We work with tadelakt and natural materials to create distinctive finishes.'}</p></div><div class="cards">{cards.map(([slug,[title,text]],i)=><article class="card"><a href={`${path.services}${slug}/`}><img src={['/assets/1d40bda2c59faa8c.jpg','/assets/0e64122f9178219a.jpg','/assets/66c1b3347c87a056.jpg'][i]} alt={title} loading="lazy" width="800" height="600"/><div class="card-body"><h3>{title}</h3><p>{text}</p></div></a></article>)}</div></div></section>
  <figure class="home-feature-image"><img src="/assets/88802dddaa2f20c3.jpg" alt="Feet on a natural tadelakt surface" width="2732" height="958" fetchpriority="high" /><figcaption class="home-feature-overlay"><blockquote>“Tadelakt Natural; Más que materiales ecológicos, trabajamos con alma, textura y amor.”</blockquote><cite>— said</cite></figcaption></figure>
  <section class="section band"><div class="container split"><div><p class="eyebrow">{fr?'Pourquoi le tadelakt':'Why tadelakt'}</p><h2>{copy.why}</h2><p>{fr?'Une finition traditionnelle à la chaux, sans joints visibles, dont le comportement dépend d’une préparation, d’une application et d’un entretien adaptés.':'A traditional lime finish with a seamless appearance, whose performance depends on proper preparation, installation and care.'}</p><a class="button" href={path.material}>{copy.discover}</a></div><img src="/assets/0320965d69a0be48.jpg" alt={fr?'Texture d’un enduit naturel à la chaux':'Natural lime plaster texture'} width="1044" height="1045" loading="lazy"/></div></section>
  <section class="section"><div class="container"><p class="eyebrow">{fr?'Notre méthode':'Our process'}</p><h2>{copy.process}</h2><div class="process"><article><h3>{fr?'Écouter':'Listen'}</h3><p>{fr?'Comprendre le lieu, son usage et vos attentes.':'Understand the space, its use and your expectations.'}</p></article><article><h3>{fr?'Préparer':'Prepare'}</h3><p>{fr?'Un support adapté est la base du résultat.':'A suitable substrate is the foundation.'}</p></article><article><h3>{fr?'Appliquer':'Apply'}</h3><p>{fr?'Travailler par couches avec précision.':'Build the finish in precise layers.'}</p></article><article><h3>{fr?'Accompagner':'Care'}</h3><p>{fr?'Partager des conseils clairs pour l’entretien.':'Share clear care guidance.'}</p></article></div></div></section>
  <section class="section cta"><div class="container narrow"><p class="eyebrow">{fr?'Parlons de votre projet':'Let’s talk about your project'}</p><h2>{copy.cta}</h2><a class="button" href={path.contact}>{copy.quote}</a></div></section>
</Layout>
