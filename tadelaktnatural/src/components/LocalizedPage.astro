---
import Layout from '../layouts/Layout.astro'; import { languagePaths } from '../i18n/config';
interface Props { locale:'fr'|'en'; kind:string; slug?:string; }
const {locale,kind}=Astro.props as Props; const fr=locale==='fr'; const p=languagePaths[locale];
const text=fr ? {material:['Qu’est-ce que le tadelakt ?', 'Le tadelakt marocain traditionnel est un revêtement naturel à la chaux, appliqué en plusieurs couches puis poli à la pierre.'], services:['Services','Des finitions naturelles pour des espaces singuliers.'], projects:['Réalisations','La matière, en contexte.'], about:['À propos','Travailler avec la matière, pas contre elle.'], faq:['Questions fréquentes','Avant de commencer.'], contact:['Contact','Parlons de votre projet.'], blog:['Journal','Comprendre avant de choisir.'], legal:['Mentions légales','Les informations légales de Tadelakt Natural.'], privacy:['Confidentialité','Informations sur la confidentialité.'], cookies:['Cookies','Informations sur les cookies.']} : {material:['What is tadelakt?','Traditional Moroccan tadelakt is a natural lime plaster applied in layers and polished with a stone.'], services:['Services','Natural finishes for distinctive spaces.'], projects:['Projects','Material, in context.'], about:['About us','Working with the material, not against it.'], faq:['Frequently asked questions','Before you begin.'], contact:['Contact','Tell us about your project.'], blog:['Journal','Understand before you choose.'], legal:['Legal notice','Tadelakt Natural legal information.'], privacy:['Privacy','Privacy information.'], cookies:['Cookies','Cookie information.']};
const data=(text as Record<string,string[]>)[kind] || text.material; const path=(p as Record<string,string>)[kind==='material'?'material':kind];
const blogPosts = fr ? [
  ['tadelakt-salles-de-bains-et-douches','Tadelakt dans les salles de bains : élégance et résistance','Les avantages et les applications du tadelakt dans les pièces humides.','/assets/1d40bda2c59faa8c.jpg'],
  ['histoire-origine-tadelakt','Histoire et origine du tadelakt : l’art ancestral de la chaux','Un voyage aux origines marocaines du tadelakt et de sa technique traditionnelle.','/assets/0320965d69a0be48.jpg'],
  ['tadelakt-exterieurs','Pourquoi choisir le tadelakt pour les extérieurs ?','Le tadelakt pour les terrasses, patios et murs extérieurs.','/assets/66c1b3347c87a056.jpg'],
  ['tadelakt-cuisines','Tadelakt dans les cuisines : beauté et résistance naturelle','Les possibilités du tadelakt pour les murs, crédences et plans de travail.','/assets/55c7ccc38c0b44d8.jpg'],
  ['couleurs-tadelakt','Quelles couleurs peut-on obtenir avec le tadelakt ?','Des inspirations de teintes naturelles pour votre projet.','/assets/493c44a4067f97a3.jpg'],
  ['bienfaits-tadelakt-bains-modernes','Les bienfaits du tadelakt pour les salles de bains modernes','Continuité, entretien et beauté artisanale pour les salles de bains contemporaines.','/assets/8fd08762dfe91b0f.jpg'],
  ['tadelakt-ou-microciment','Tadelakt ou microciment : quel revêtement choisir ?','Les différences entre ces deux systèmes de revêtement.','/assets/493c44a4067f97a3.jpg'],
  ['pourquoi-choisir-tadelakt-salle-de-bains','Pourquoi choisir le tadelakt pour la salle de bains ?','Les raisons de choisir une finition naturelle et continue.','/assets/1d40bda2c59faa8c.jpg'],
  ['entretenir-nettoyer-tadelakt','Comment entretenir et nettoyer correctement le tadelakt','Les gestes simples pour préserver votre finition.','/assets/0e64122f9178219a.jpg'],
  ['technique-tadelakt','La technique du tadelakt : les secrets de son application','Support, couches, polissage et protection : les étapes essentielles.','/assets/0320965d69a0be48.jpg'],
  ['pourquoi-choisir-tadelakt','Pourquoi choisir le tadelakt ?','Les qualités naturelles, esthétiques et artisanales du tadelakt.','/assets/66c1b3347c87a056.jpg'],
  ['5-raisons-tadelakt-salle-de-bains','5 raisons de choisir le tadelakt pour votre salle de bains','Cinq arguments pour une salle de bains minérale et personnalisée.','/assets/1d40bda2c59faa8c.jpg']
] : [
  ['tadelakt-bathrooms-and-showers','Tadelakt bathrooms: elegance and resistance in wet spaces','The benefits and applications of tadelakt in wet rooms.','/assets/1d40bda2c59faa8c.jpg'],
  ['tadelakt-history-origin','History and origin of tadelakt: the ancient art of lime','A journey through Moroccan origins and traditional technique.','/assets/0320965d69a0be48.jpg'],
  ['tadelakt-outdoors','Why choose tadelakt for outdoor spaces?','Tadelakt for terraces, patios and exterior walls.','/assets/66c1b3347c87a056.jpg'],
  ['tadelakt-kitchens','Tadelakt kitchens: beauty and natural resistance','Using tadelakt on walls, splashbacks and worktops.','/assets/55c7ccc38c0b44d8.jpg'],
  ['tadelakt-colours','What colours can tadelakt achieve?','Natural colour inspiration for your project.','/assets/493c44a4067f97a3.jpg'],
  ['tadelakt-benefits-modern-bathrooms','Benefits of tadelakt for modern bathrooms','Continuity, care and craft for contemporary bathrooms.','/assets/8fd08762dfe91b0f.jpg'],
  ['tadelakt-or-microcement','Tadelakt or microcement: which finish should you choose?','The differences between these two finishing systems.','/assets/493c44a4067f97a3.jpg'],
  ['why-choose-tadelakt-bathroom','Why choose tadelakt for a bathroom?','Reasons to choose a natural, seamless finish.','/assets/1d40bda2c59faa8c.jpg'],
  ['clean-and-maintain-tadelakt','How to clean and maintain tadelakt correctly','Simple steps to preserve your finish.','/assets/0e64122f9178219a.jpg'],
  ['tadelakt-technique','The tadelakt technique: secrets of this ancestral finish','Substrate, layers, polishing and protection.','/assets/0320965d69a0be48.jpg'],
  ['why-choose-tadelakt','Why choose tadelakt?','The natural, aesthetic and crafted qualities of tadelakt.','/assets/66c1b3347c87a056.jpg'],
  ['5-reasons-tadelakt-bathroom','5 reasons to choose tadelakt for your bathroom','Five arguments for a mineral and personal bathroom.','/assets/1d40bda2c59faa8c.jpg']
];
const equivalents = { material:{es:'/es/que-es-el-tadelakt/',fr:'/fr/quest-ce-que-le-tadelakt/',en:'/en/what-is-tadelakt/'}, services:{es:'/es/servicios/',fr:'/fr/services/',en:'/en/services/'}, projects:{es:'/es/proyectos/',fr:'/fr/realisations/',en:'/en/projects/'}, about:{es:'/es/sobre-nosotros/',fr:'/fr/a-propos/',en:'/en/about/'}, faq:{es:'/es/preguntas-frecuentes/',fr:'/fr/questions-frequentes/',en:'/en/faq/'}, contact:{es:'/es/contacto/',fr:'/fr/contact/',en:'/en/contact/'}, blog:{es:'/es/blog/',fr:'/fr/blog/',en:'/en/blog/'}, legal:{es:'/es/aviso-legal/',fr:'/fr/mentions-legales/',en:'/en/legal-notice/'}, privacy:{es:'/es/privacidad/',fr:'/fr/confidentialite/',en:'/en/privacy/'}, cookies:{es:'/es/cookies/',fr:'/fr/cookies/',en:'/en/cookies/'} }[kind as 'material'|'services'|'projects'|'about'|'faq'|'contact'|'blog'|'legal'|'privacy'|'cookies'];
const body = kind==='material' ? (fr ? ['Le tadelakt est originaire du Maroc. Son intérêt tient à sa continuité, ses nuances et son toucher.','Lorsqu’il est correctement conçu, appliqué et entretenu, il peut convenir à certaines zones humides. Il ne doit toutefois pas être présenté comme indestructible ou universellement imperméable.','Il s’utilise notamment dans les salles de bains, douches, hammams, piscines, cuisines et projets décoratifs.'] : ['Tadelakt originated in Morocco. Its appeal lies in its continuity, tonal variation and tactile surface.','When properly specified, installed and maintained, it can suit some wet areas. It should not be presented as indestructible or universally waterproof.','It is used for bathrooms, showers, hammams, pools, kitchens and decorative projects.']) : kind==='about' ? (fr ? ['Said est artisan spécialisé en tadelakt traditionnel et techniques de bioconstruction. Il travaille avec des matériaux naturels appliqués à la main.','Chaque projet recherche un équilibre entre esthétique, durabilité et respect du lieu.'] : ['Said is a craftsperson specialising in traditional tadelakt and natural building techniques. He works with natural materials applied by hand.','Each project seeks a balance between aesthetics, durability and respect for the space.']) : (kind==='legal' ? [fr?'Cette page doit être complétée avec l’identité légale du responsable avant la publication définitive.':'This page must be completed with the responsible legal entity before final publication.'] : kind==='privacy' ? [fr?'Aucune donnée n’est envoyée par le formulaire tant qu’aucun service n’est connecté.':'No data is sent by the form until a service is connected.'] : kind==='cookies' ? [fr?'Aucun outil d’analyse ni cookie non essentiel n’est activé dans cette version.':'No analytics or non-essential cookies are active in this version.'] : []);
const title=`${data[0]} | Tadelakt Natural`; const desc=data[1];
---
<Layout locale={locale} title={title} description={desc} path={path} equivalents={equivalents}><div class="breadcrumbs">{fr?'Accueil':'Home'} / {data[0]}</div><section class:list={["section", "container", kind !== 'blog' && 'narrow']}><p class="eyebrow">Tadelakt Natural</p><h1>{data[0]}</h1><p class="lead">{data[1]}</p>{kind==='material' && <img src="/assets/196d6fc9362d4680.jpg" alt={fr?'Application artisanale de tadelakt':'Hand-applied tadelakt finish'} width="994" height="1018" loading="lazy"/>}{body.map((paragraph)=><p>{paragraph}</p>)}{kind==='faq' && <div class="faq"><details><summary>{fr?'Le tadelakt est-il imperméable ?':'Is tadelakt waterproof?'}</summary><p>{fr?'Son comportement dépend du système complet, de l’application et de l’entretien.':'Its performance depends on the complete system, installation and care.'}</p></details><details><summary>{fr?'Comment l’entretenir ?':'How is it maintained?'}</summary><p>{fr?'Avec des produits doux et selon les conseils de l’artisan.':'With gentle products and the craftsperson’s care guidance.'}</p></details></div>}{kind==='contact' && <p><a class="button" href={`mailto:tadelaktnatural@gmail.com`}>{fr?'Écrire par e-mail':'Email us'}</a></p>}{kind==='blog' && <div class="cards">{blogPosts.map(([slug,postTitle,description,image])=><article class="card"><a href={`${p.blog}${slug}/`}><img src={image} alt={postTitle} width="1000" height="750" loading="lazy"/><div class="card-body"><h2>{postTitle}</h2><p>{description}</p><span>{fr?'Lire l’article →':'Read article →'}</span></div></a></article>)}</div>}</section></Layout>
