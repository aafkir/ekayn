---
import Layout from '../layouts/Layout.astro'; import { languagePaths } from '../i18n/config';
const {locale}=Astro.props as {locale:'fr'|'en'}; const fr=locale==='fr'; const p=languagePaths[locale];
---
<Layout locale={locale} title={fr?'Contact et devis tadelakt | Tadelakt Natural':'Tadelakt quote and contact | Tadelakt Natural'} description={fr?'Parlez-nous de votre projet de tadelakt et demandez un devis.':'Tell us about your tadelakt project and request a quote.'} path={p.contact} equivalents={{es:'/es/contacto/',fr:'/fr/contact/',en:'/en/contact/'}}><div class="breadcrumbs">{fr?'Accueil':'Home'} / {fr?'Contact':'Contact'}</div><section class="section container contact-grid"><div><p class="eyebrow">{fr?'Contact':'Contact'}</p><h1>{fr?'Parlons de votre projet.':'Tell us about your project.'}</h1><p class="lead">{fr?'Écrivez à':'Email'} <a href="mailto:tadelaktnatural@gmail.com">tadelaktnatural@gmail.com</a>.</p></div><form onsubmit="return false"><input type="hidden" name="locale" value={locale}/><label>{fr?'Nom':'Name'}<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>{fr?'Téléphone (facultatif)':'Phone (optional)'}<input type="tel" name="phone" autocomplete="tel" /></label><label>{fr?'Type de projet':'Project type'}<input name="project" placeholder={fr?'Salle de bains, douche, piscine…':'Bathroom, shower, pool…'} /></label><label>{fr?'Surface approximative':'Approximate area'}<input name="surface" placeholder="m²" /></label><label>{fr?'Message':'Message'}<textarea name="message" required></textarea></label><label><span><input type="checkbox" required /> {fr?'J’accepte la':'I accept the'} <a href={p.privacy}>{fr?'politique de confidentialité':'privacy policy'}</a>.</span></label><button class="button" type="submit">{fr?'Préparer la demande':'Prepare request'}</button><small>{fr?'Le formulaire n’est pas encore connecté. Utilisez l’adresse e-mail ci-dessus pour un envoi fonctionnel.':'The form is not connected yet. Use the email above for a working contact method.'}</small></form></section></Layout>
