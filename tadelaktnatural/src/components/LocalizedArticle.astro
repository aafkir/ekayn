---
import Layout from '../layouts/Layout.astro'; import { languagePaths } from '../i18n/config';
interface Props { locale:'fr'|'en'; slug:string; }
const {locale,slug}=Astro.props as Props; const fr=locale==='fr'; const p=languagePaths[locale];
const articles:Record<string,[string,string,string[]]> = fr ? {
  'quest-ce-que-le-tadelakt-origine-proprietes-applications':['Qu’est-ce que le tadelakt : origine, propriétés et applications','Le tadelakt marocain traditionnel est un revêtement naturel à la chaux, appliqué en couches puis poli à la pierre.',['Originaire du Maroc, le tadelakt séduit par sa continuité, ses nuances et son toucher. Chaque réalisation conserve une part du geste artisanal.','Correctement conçu, appliqué et entretenu, il peut convenir à certains espaces humides. Il ne doit pas être présenté comme indestructible ou universellement imperméable.','On le retrouve notamment dans les salles de bains, douches, hammams, piscines, cuisines et projets décoratifs.']],
  'tadelakt-salles-de-bains-et-douches':['Tadelakt pour salles de bains et douches : avantages et précautions','Une surface de salle de bains en tadelakt peut apporter continuité, chaleur et profondeur.',['La réussite dépend du support, de la préparation, de l’application et de l’entretien. Le matériau seul ne garantit pas le comportement final.','Une finition sans joints visibles apporte une lecture plus calme de l’espace, mais elle doit être entretenue avec des produits doux et adaptés.']],
  'tadelakt-ou-microciment':['Tadelakt ou microciment : comment choisir','Deux solutions de revêtement, deux systèmes et deux expressions de la matière.',['Le tadelakt est un enduit traditionnel de chaux poli à la main. Le microciment est un système contemporain dont la composition dépend du fabricant.','Pour choisir, comparez le support, l’usage, le rendu souhaité, le niveau d’entretien et l’applicateur.']]
} : {
  'what-is-tadelakt-origin-properties-uses':['What is tadelakt? Origin, properties and uses','Traditional Moroccan tadelakt is a natural lime plaster applied in layers and polished with a stone.',['Originating in Morocco, tadelakt is valued for its continuity, tonal variation and tactile character. Each finish carries the mark of the craft.','When properly specified, installed and maintained, it can suit some wet areas. It should not be presented as indestructible or universally waterproof.','It is used for bathrooms, showers, hammams, pools, kitchens and decorative projects.']],
  'tadelakt-bathrooms-and-showers':['Tadelakt bathrooms and showers: benefits and precautions','A tadelakt bathroom can bring continuity, warmth and depth to a space.',['The result depends on the substrate, preparation, installation and care. The material alone does not guarantee performance.','A seamless finish creates a calmer visual language, but it should be maintained with gentle, suitable products.']],
  'tadelakt-or-microcement':['Tadelakt or microcement: how to choose','Two finishes, two systems and two ways of expressing material.',['Tadelakt is a traditional lime plaster polished by hand. Microcement is a contemporary system whose composition depends on the manufacturer.','Compare the substrate, use, desired look, care requirements and installer before choosing.']]
};
const [title,desc,sections]=articles[slug]; const equivalents = fr ? {es:'/es/blog/que-es-el-tadelakt-origen-propiedades-aplicaciones/',fr:`/fr/blog/${slug}/`,en:'/en/blog/what-is-tadelakt-origin-properties-uses/'} : {es:'/es/blog/que-es-el-tadelakt-origen-propiedades-aplicaciones/',fr:'/fr/blog/quest-ce-que-le-tadelakt-origine-proprietes-applications/',en:`/en/blog/${slug}/`};
---
<Layout locale={locale} title={`${title} | Tadelakt Natural`} description={desc} path={`${p.blog}${slug}/`} equivalents={equivalents} image="/assets/0320965d69a0be48.jpg" schema={{'@type':'Article',headline:title,description:desc,inLanguage:locale}}><div class="breadcrumbs">{fr?'Accueil':'Home'} / {fr?'Journal':'Journal'} / {title}</div><article class="section prose"><p class="eyebrow">{fr?'Guide pratique':'Practical guide'}</p><h1>{title}</h1><p class="lead">{desc}</p><img src="/assets/0320965d69a0be48.jpg" alt={title} width="1044" height="1045" fetchpriority="high" /><h2>{fr?'À retenir':'Key points'}</h2>{sections.map((section)=><p>{section}</p>)}<p><a class="button" href={p.contact}>{fr?'Demander un devis':'Request a quote'}</a></p></article></Layout>
