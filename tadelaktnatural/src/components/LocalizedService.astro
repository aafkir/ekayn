---
import Layout from '../layouts/Layout.astro'; import { languagePaths, localizedServices } from '../i18n/config';
interface Props { locale:'fr'|'en'; slug:string; }
const {locale,slug}=Astro.props as Props; const fr=locale==='fr'; const item=(localizedServices[locale] as Record<string,readonly [string,string]>)[slug]; const p=languagePaths[locale]; const title=item?.[0] || (fr?'Service de tadelakt':'Tadelakt service'); const image=slug.includes('pisc')||slug==='pools'?'/assets/66c1b3347c87a056.jpg':'/assets/1d40bda2c59faa8c.jpg';
const serviceSlugs: Record<'fr'|'en', Record<string, Partial<Record<'es'|'fr'|'en',string>>>> = { fr:{'salles-de-bains-et-douches':{es:'banos-y-duchas',en:'bathrooms-and-showers'},hammams:{es:'hammams',en:'hammams'},piscines:{es:'piscinas',en:'pools'},'cuisines-et-plans-de-travail':{es:'cocinas-y-encimeras',en:'kitchens-and-worktops'},'murs-et-sols':{es:'paredes-y-suelos',en:'walls-and-floors'}}, en:{'bathrooms-and-showers':{es:'banos-y-duchas',fr:'salles-de-bains-et-douches'},hammams:{es:'hammams',fr:'hammams'},pools:{es:'piscinas',fr:'piscines'},'kitchens-and-worktops':{es:'cocinas-y-encimeras',fr:'cuisines-et-plans-de-travail'},'walls-and-floors':{es:'paredes-y-suelos',fr:'murs-et-sols'}} } as const;
const equivalents = { es:`/es/servicios/${serviceSlugs[locale][slug].es}/`, fr:`/fr/services/${serviceSlugs[locale][slug].fr || slug}/`, en:`/en/services/${serviceSlugs[locale][slug].en || slug}/` };
---
<Layout locale={locale} title={`${title} | Tadelakt Natural`} description={item?.[1] || title} path={`${p.services}${slug}/`} equivalents={equivalents} image={image} schema={{'@type':'Service',name:title,provider:{'@type':'Organization',name:'Tadelakt Natural'},description:item?.[1]}}><div class="breadcrumbs">{fr?'Accueil':'Home'} / {fr?'Services':'Services'} / {title}</div><section class="section container split"><div><p class="eyebrow">Tadelakt Natural</p><h1>{title}</h1><p class="lead">{item?.[1]}</p><p>{fr?'Le résultat dépend du support, du système de couches, du polissage et de l’usage réel de la pièce.':'The result depends on the substrate, layer system, polishing and the room’s actual use.'}</p><a class="button" href={p.contact}>{fr?'Demander un devis':'Request a quote'}</a></div><img src={image} alt={title} width="1500" height="1125" fetchpriority="high" /></section></Layout>
